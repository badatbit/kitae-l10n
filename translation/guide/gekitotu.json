{
  "script": "gekitotu.msl",
  "entries": [
    {
      "window": 0,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "『激突！！』",
        "ko": "『격돌!!』"
      }
    },
    {
      "window": 0,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "　　　　　　　　　　　　　　　　作：　日比野　喜",
        "ko": "              작: 히비노 요시"
      }
    },
    {
      "window": 1,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "＜１＞",
        "ko": "<1>"
      }
    },
    {
      "window": 1,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "　　　　　　　　　　　　　　　　　　　　　　　　　",
        "ko": "                         "
      }
    },
    {
      "window": 1,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "「あっ！！」",
        "ko": "「앗!!」"
      }
    },
    {
      "window": 2,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "目があった瞬間　占い師は素っ頓狂な声を上げた。",
        "ko": "눈이 마주친 순간, 점쟁이가 엉뚱한 소리를 질렀다."
      }
    },
    {
      "window": 2,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "私は立ち止まり　もう一度　彼女を見る。",
        "ko": "나는 걸음을 멈추고 다시 한번 그녀를 본다."
      }
    },
    {
      "window": 3,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "２０代後半・・黒いショールを羽織った女性が",
        "ko": "20대 후반・・검은 숄을 걸친 여자가"
      }
    },
    {
      "window": 3,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "気まずそうに下を向いていた。",
        "ko": "겸연쩍은 듯 고개를 숙이고 있었다."
      }
    },
    {
      "window": 4,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「・・・何か・・？」",
        "ko": "「・・・뭔가・・?」"
      }
    },
    {
      "window": 4,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "「いえ・・何でもありません！",
        "ko": "「아뇨・・아무것도 아니에요!"
      }
    },
    {
      "window": 4,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "お気になさらずに・・」",
        "ko": "신경 쓰지 마세요・・」"
      }
    },
    {
      "window": 5,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "この状況では　気にするなと言う方が無理だ。",
        "ko": "이 상황에서 신경 쓰지 말라는 게 무리다."
      }
    },
    {
      "window": 6,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「でもさっき　私を見て驚いたような",
        "ko": "「하지만 방금 저를 보고 놀란 듯한"
      }
    },
    {
      "window": 6,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "声を上げましたよね。」",
        "ko": "소리를 내셨잖아요.」"
      }
    },
    {
      "window": 7,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「本当に・・何でもないんです。",
        "ko": "「정말・・아무것도 아니에요."
      }
    },
    {
      "window": 7,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "あの・・忘れ物を・・思い出しまして・・」",
        "ko": "저・・두고 온 물건이・・생각나서・・」"
      }
    },
    {
      "window": 8,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "うろたえ方がわざとらしすぎる。",
        "ko": "당황하는 모양새가 너무 어색하다."
      }
    },
    {
      "window": 8,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "これはきっと演技だ。しかし・・何のために？",
        "ko": "분명 연기다. 하지만・・무엇 때문에?"
      }
    },
    {
      "window": 9,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "ひょっとしたらこれは新しい客引きの手口なのかも",
        "ko": "어쩌면 이건 새로운 호객 수법인지도"
      }
    },
    {
      "window": 9,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "しれない。そう思った私は彼女の目を見ながら",
        "ko": "모른다. 그렇게 생각한 나는 그녀의 눈을 보며"
      }
    },
    {
      "window": 9,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "きっぱりと言った。",
        "ko": "딱 잘라 말했다."
      }
    },
    {
      "window": 10,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「そうですか・・それでは　さようなら・・」",
        "ko": "「그렇습니까・・그럼 안녕히・・」"
      }
    },
    {
      "window": 10,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "きびすを返し立ち去ろうとすると",
        "ko": "발길을 돌려 자리를 뜨려 하자"
      }
    },
    {
      "window": 10,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "案の定彼女が呼び止めてきた。",
        "ko": "아니나 다를까 그녀가 불러 세웠다."
      }
    },
    {
      "window": 11,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「あっ！　あの・・」",
        "ko": "「앗! 저・・」"
      }
    },
    {
      "window": 12,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "ますます怪しい。",
        "ko": "점점 더 수상하다."
      }
    },
    {
      "window": 12,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "しかしこれだけ怪しいと逆に騙されたフリでもして",
        "ko": "하지만 이렇게 수상하면 오히려 속는 척이라도 해서"
      }
    },
    {
      "window": 12,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "からかってみようかという気分になってくる。",
        "ko": "놀려 볼까 하는 기분이 든다."
      }
    },
    {
      "window": 13,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「それじゃせっかくだから　占って下さい。",
        "ko": "「그럼 기왕이니 점을 봐 주세요."
      }
    },
    {
      "window": 13,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "私の名前は山田三郎。会社員です。」",
        "ko": "제 이름은 야마다 사부로. 회사원입니다.」"
      }
    },
    {
      "window": 14,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "しかし彼女は俯いたまま首を横に振って",
        "ko": "하지만 그녀는 고개를 숙인 채 가로저으며"
      }
    },
    {
      "window": 14,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "「占わなくても・・わかります。あなたは『怨の力』が",
        "ko": "「점을 안 봐도・・알아요. 당신은 『원의 힘』이"
      }
    },
    {
      "window": 14,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "強い・・いえ・・強すぎます。」",
        "ko": "강해요・・아니・・너무 강해요.」"
      }
    },
    {
      "window": 15,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「『怨の力』・・ですか？」",
        "ko": "「『원의 힘』・・이라고요?」"
      }
    },
    {
      "window": 16,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「人を怨む力・・怨恨の『怨』です。",
        "ko": "「남을 원망하는 힘・・원한의 『원』이에요."
      }
    },
    {
      "window": 16,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "あなたは今・・誰か憎んでいる人はいませんか？」",
        "ko": "당신은 지금・・누군가 미워하는 사람이 없나요?」"
      }
    },
    {
      "window": 17,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "サラリーマンを１０年もやっていると",
        "ko": "회사원 생활을 10년이나 하다 보면"
      }
    },
    {
      "window": 17,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "それはウマの合わないやつも出てくる。",
        "ko": "안 맞는 녀석도 나오기 마련이다."
      }
    },
    {
      "window": 18,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "しかしだからと言って　憎んでいるわけではない。",
        "ko": "하지만 그렇다고 미워하는 건 아니다."
      }
    },
    {
      "window": 18,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "仕事相手として認めているからこそ対立がある・・",
        "ko": "일 상대로 인정하기에 대립도 있는 것・・"
      }
    },
    {
      "window": 19,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「そしてあなたの憎んだ相手が・・",
        "ko": "「그리고 당신이 미워한 상대가・・"
      }
    },
    {
      "window": 19,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "例えば交通事故にあったり　肉親を亡くされたりした",
        "ko": "예를 들어 교통사고를 당하거나 가족을 잃거나 한"
      }
    },
    {
      "window": 19,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "記憶はありませんか？」",
        "ko": "기억은 없나요?」"
      }
    },
    {
      "window": 20,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "交通事故なんて珍しいものじゃないし",
        "ko": "교통사고야 드문 일도 아니고"
      }
    },
    {
      "window": 20,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "肉親の不幸なんて　我々の世代になったら",
        "ko": "가족의 불행도 우리 세대쯤 되면"
      }
    },
    {
      "window": 20,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "それこそ特別なことではない。",
        "ko": "그야말로 특별한 일이 아니다."
      }
    },
    {
      "window": 21,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「それは全て・・・・",
        "ko": "「그건 전부・・・・"
      }
    },
    {
      "window": 21,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "あなたの怨の力が影響しているのです。」",
        "ko": "당신의 원의 힘이 미친 영향이에요.」"
      }
    },
    {
      "window": 22,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "いきなり決めつけられてしまった。",
        "ko": "대뜸 단정을 지어 버렸다."
      }
    },
    {
      "window": 22,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "私は苦笑しながら",
        "ko": "나는 쓴웃음을 지으며"
      }
    },
    {
      "window": 23,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「悪いけど私は誰も怨んでなんていないよ。",
        "ko": "「미안하지만 난 아무도 원망하지 않아요."
      }
    },
    {
      "window": 23,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "それに今あげた不幸なんて・・」",
        "ko": "게다가 방금 든 불행이라는 것도・・」"
      }
    },
    {
      "window": 24,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "しかし彼女は私の言葉を遮って",
        "ko": "하지만 그녀는 내 말을 가로막고"
      }
    },
    {
      "window": 24,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "強い口調でこう続けた。",
        "ko": "강한 어조로 이렇게 이었다."
      }
    },
    {
      "window": 25,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「いいえ。私には見えます。",
        "ko": "「아니요. 저에게는 보여요."
      }
    },
    {
      "window": 25,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "あなたの発している強大な『怨』の思念が・・",
        "ko": "당신이 내뿜는 강대한 『원』의 생각이・・"
      }
    },
    {
      "window": 26,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "・・・世の中には二つの見えない力があります。",
        "ko": "・・・세상에는 두 가지 보이지 않는 힘이 있어요."
      }
    },
    {
      "window": 26,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "人を呪う『怨』の力と",
        "ko": "남을 저주하는 『원』의 힘과"
      }
    },
    {
      "window": 26,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "人を慈しむ『愛』の力です。",
        "ko": "남을 아끼는 『애』의 힘이에요."
      }
    },
    {
      "window": 27,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "愛の力は人を幸福にし　怨の力は人を不幸にします。",
        "ko": "애의 힘은 사람을 행복하게, 원의 힘은 불행하게 해요."
      }
    },
    {
      "window": 27,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "しかしたいていの場合　その力は非常に弱いため",
        "ko": "하지만 대개는 그 힘이 아주 약해서"
      }
    },
    {
      "window": 27,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "他人の運命を大きく左右するようなことはありません。",
        "ko": "남의 운명을 크게 좌우하는 일은 없어요."
      }
    },
    {
      "window": 28,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "しかしあなたの場合　生まれつき『怨』の力が",
        "ko": "하지만 당신은 타고나기를 『원』의 힘이"
      }
    },
    {
      "window": 28,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "強いのです。あなたの怨んだ人は　必ず不幸に",
        "ko": "강해요. 당신이 원망한 사람은 반드시 불행해지고"
      }
    },
    {
      "window": 28,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "なってしまうのです。」",
        "ko": "마는 거예요.」"
      }
    },
    {
      "window": 29,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "そら来た。そうやって不安を煽っておいて",
        "ko": "그럼 그렇지. 그렇게 불안을 부추겨 놓고"
      }
    },
    {
      "window": 29,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "だからお守りを買えとか寄付しろとか言って来るんだ。",
        "ko": "부적을 사라느니 기부하라느니 할 셈이겠지."
      }
    },
    {
      "window": 29,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "その手には乗らないぞ・・",
        "ko": "그 수에는 안 넘어간다・・"
      }
    },
    {
      "window": 30,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "しかし意外なことに彼女は見料も取らず",
        "ko": "하지만 뜻밖에도 그녀는 복채도 받지 않고"
      }
    },
    {
      "window": 30,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "物を売りつけるような気配も見せない。",
        "ko": "뭔가를 팔아넘길 기색도 보이지 않는다."
      }
    },
    {
      "window": 31,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "「人を怨まず・・常に心を『愛』で満たして下さい。",
        "ko": "「남을 원망하지 말고・・늘 마음을 『애』로 채우세요."
      }
    },
    {
      "window": 31,
      "line": 1,
      "speaker": "소설",
      "text": {
        "ja": "私のお願いは　それだけです。それと・・何かあったら",
        "ko": "제 부탁은 그것뿐이에요. 그리고・・무슨 일이 있으면"
      }
    },
    {
      "window": 31,
      "line": 2,
      "speaker": "소설",
      "text": {
        "ja": "ここに来てください。私は花房ミヤコと言います。」",
        "ko": "여기로 오세요. 저는 하나부사 미야코라고 해요.」"
      }
    },
    {
      "window": 32,
      "line": 0,
      "speaker": "소설",
      "text": {
        "ja": "そう言って寂しそうな笑顔を浮かべただけだった。",
        "ko": "그렇게 말하고 쓸쓸한 미소를 지었을 뿐이었다."
      }
    },
    {
      "window": 33,
      "line": 0,
      "speaker": "소설",
      "text": {
