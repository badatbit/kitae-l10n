      "scene": 0,
      "date": null,
      "slot": null,
      "place": "占いメッセージ",
      "voice": "",
      "chars": 13,
      "text": {
        "ja": "無料で占って差し上げます。",
        "ko": "무료로 점쳐 드립니다."
      }
