   }
  },
  {
   "window": 1,
   "line": 2,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 6,
   "text": {
    "ja": "「あっ！！」",
    "ko": "「앗！！」"
   }
  },
  {
   "window": 2,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 23,
   "text": {
    "ja": "目があった瞬間　占い師は素っ頓狂な声を上げた。",
    "ko": "눈이　마주친　순간　점쟁이가　괴성을　질렀다．"
   }
  },
  {
   "window": 2,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 19,
   "text": {
    "ja": "私は立ち止まり　もう一度　彼女を見る。",
    "ko": "나는　멈춰　서서　다시　한번　그녀를　본다．"
   }
  },
  {
   "window": 3,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 21,
   "text": {
    "ja": "２０代後半・・黒いショールを羽織った女性が",
    "ko": "２０대　후반・・검은　숄을　걸친　여성이"
   }
  },
  {
   "window": 3,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 14,
   "text": {
    "ja": "気まずそうに下を向いていた。",
    "ko": "어색한　듯　고개를　숙이고　있었다．"
   }
  },
  {
   "window": 4,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 10,
   "text": {
    "ja": "「・・・何か・・？」",
    "ko": "「・・・무슨　일・・？」"
   }
  },
  {
   "window": 4,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 14,
   "text": {
    "ja": "「いえ・・何でもありません！",
    "ko": "「아뇨・・아무것도　아니에요！"
   }
  },
  {
   "window": 4,
   "line": 2,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 11,
   "text": {
    "ja": "お気になさらずに・・」",
    "ko": "신경　쓰지　마세요・・」"
   }
  },
  {
   "window": 5,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 21,
   "text": {
    "ja": "この状況では　気にするなと言う方が無理だ。",
    "ko": "이　상황에서　신경　쓰지　말라는　건　무리다．"
   }
  },
  {
   "window": 6,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 17,
   "text": {
    "ja": "「でもさっき　私を見て驚いたような",
    "ko": "「근데　아까　나를　보고　놀란　듯한"
   }
  },
  {
   "window": 6,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 11,
   "text": {
    "ja": "声を上げましたよね。」",
    "ko": "소리를　냈잖아요．」"
   }
  },
  {
   "window": 7,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 15,
   "text": {
    "ja": "「本当に・・何でもないんです。",
    "ko": "「정말・・아무것도　아니에요．"
   }
  },
  {
   "window": 7,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 20,
   "text": {
    "ja": "あの・・忘れ物を・・思い出しまして・・」",
    "ko": "저・・두고　온　걸・・떠올라서・・」"
   }
  },
  {
   "window": 8,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 15,
   "text": {
    "ja": "うろたえ方がわざとらしすぎる。",
    "ko": "당황하는　게　너무　부자연스럽다．"
   }
  },
  {
   "window": 8,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 21,
   "text": {
    "ja": "これはきっと演技だ。しかし・・何のために？",
    "ko": "이건　분명　연기다．근데・・무엇　때문에？"
   }
  },
  {
   "window": 9,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 23,
   "text": {
    "ja": "ひょっとしたらこれは新しい客引きの手口なのかも",
    "ko": "어쩌면　이건　새로운　호객　수법일지도"
   }
  },
  {
   "window": 9,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 21,
   "text": {
    "ja": "しれない。そう思った私は彼女の目を見ながら",
    "ko": "모른다．그렇게　생각한　나는　그녀의　눈을　보며"
   }
  },
  {
   "window": 9,
   "line": 2,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 9,
   "text": {
    "ja": "きっぱりと言った。",
    "ko": "딱　잘라　말했다．"
   }
  },
  {
   "window": 10,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 21,
   "text": {
    "ja": "「そうですか・・それでは　さようなら・・」",
    "ko": "「그런가요・・그럼　안녕히・・」"
   }
  },
  {
   "window": 10,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 15,
   "text": {
    "ja": "きびすを返し立ち去ろうとすると",
    "ko": "발길을　돌려　떠나려　하자"
   }
  },
  {
   "window": 10,
   "line": 2,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 14,
   "text": {
    "ja": "案の定彼女が呼び止めてきた。",
    "ko": "아니나　다를까　그녀가　불러　세웠다．"
   }
  },
  {
   "window": 11,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 10,
   "text": {
    "ja": "「あっ！　あの・・」",
    "ko": "「앗！　저・・」"
   }
  },
  {
   "window": 12,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 8,
   "text": {
    "ja": "ますます怪しい。",
    "ko": "점점　더　수상하다．"
   }
  },
  {
   "window": 12,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 23,
   "text": {
    "ja": "しかしこれだけ怪しいと逆に騙されたフリでもして",
    "ko": "근데　이렇게　수상하면　오히려　속은　척하며"
   }
  },
  {
   "window": 12,
   "line": 2,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 21,
   "text": {
    "ja": "からかってみようかという気分になってくる。",
    "ko": "놀려　볼까　하는　기분이　든다．"
   }
  },
  {
   "window": 13,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 20,
   "text": {
    "ja": "「それじゃせっかくだから　占って下さい。",
    "ko": "「그럼　모처럼이니　점　봐　주세요．"
   }
  },
  {
   "window": 13,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 17,
   "text": {
    "ja": "私の名前は山田三郎。会社員です。」",
    "ko": "제　이름은　야마다　사부로．회사원이에요．」"
   }
  },
  {
   "window": 14,
   "line": 0,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 18,
   "text": {
    "ja": "しかし彼女は俯いたまま首を横に振って",
    "ko": "하지만　그녀는　숙인　채　고개를　저으며"
   }
  },
  {
   "window": 14,
   "line": 1,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 25,
   "text": {
    "ja": "「占わなくても・・わかります。あなたは『怨の力』が",
    "ko": "「점치지　않아도・・알아요．당신은『원의　힘』이"
   }
  },
  {
   "window": 14,
   "line": 2,
   "speaker": "?",
   "kind": "대사",
   "scene": null,
   "date": null,
   "slot": null,
   "place": null,
   "voice": "",
   "chars": 15,
   "text": {
    "ja": "強い・・いえ・・強すぎます。」",
    "ko": "강해요・・아니・・너무　강해요．」"
   }
  }
 ]
}